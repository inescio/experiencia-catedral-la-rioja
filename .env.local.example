# ─────────────────────────────────────────
# Experiencia Catedral La Rioja — Env vars
# ─────────────────────────────────────────
# Copia este archivo como .env.local y completá los valores.

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://catedralrioja.com.ar

# Google Analytics 4 — Measurement ID (GA4)
# Formato: G-XXXXXXXXXX
# Obtené el ID en: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Maps API Key (opcional)
# Usada si querés usar el componente GoogleMapsEmbed de @next/third-parties
# Obtené la clave en: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
